{{!--
  The opening of a message. Left-aligned rather than centred: the brand bar
  above already does the centred, ceremonial part, and body copy that starts
  centred then switches to left ragged reads as two different emails.
--}}
<h1 style="margin:0 0 8px; font-size:24px; line-height:1.3; font-weight:700; color:#2C1810;">{{title}}</h1>
{{#if subtitle}}
<p style="margin:0 0 24px; font-size:15px; line-height:1.6; color:#8A7C6E;">{{subtitle}}</p>
{{else}}
<div style="height:16px; line-height:16px; font-size:0;">&nbsp;</div>
{{/if}}
