{{!--
  A call to action.

  A table rather than a styled <a>: Outlook ignores padding on an anchor, so a
  div-based button there collapses to bare underlined text. The colour is set
  with bgcolor as well as CSS for the same reason.

  The anchor carries its own inline colour because a stripped stylesheet
  otherwise leaves white-on-white — the one failure that makes a button
  invisible rather than merely plain.
--}}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 8px 0 24px;">
    <tr>
        <td align="center" bgcolor="#2C1810" style="background-color:#2C1810; border-radius:10px;">
            <a href="{{url}}" target="_blank" rel="noopener"
                style="display:inline-block; padding:14px 30px; font-size:15px; font-weight:600; color:#FFFFFF; text-decoration:none; border-radius:10px;">
                {{text}}
            </a>
        </td>
    </tr>
</table>
