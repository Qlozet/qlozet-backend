{{!--
  Qlozet email shell.

  Built for mail clients, not browsers. Three rules shape it:

  1. Tables, not divs. Outlook renders through Word, which ignores most CSS on
     block elements — a div-based 600px container collapses to full width
     there, which is how an email ends up unreadable on a corporate laptop.
  2. Solid colours, no gradients. Outlook drops a gradient entirely, and the
     old header relied on one for its background: white text on white.
  3. Every colour also written inline where it matters. Embedded CSS survives
     most clients now, but not all, and a stripped stylesheet should leave a
     plain readable email rather than a broken one.

  Class names from before are all still defined — the views use `divider`,
  `security-note`, `code`, `card`, `muted` and others, and several of those
  were never in the stylesheet at all, so they had been rendering bare.
--}}
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    {{!-- Ask clients not to invert our palette; several will anyway. --}}
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>{{subject}}</title>

    {{!-- Honoured by Apple Mail, iOS Mail and Outlook for Mac; ignored
          everywhere else, which is why the stack below it matters more than
          this line does. --}}
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet" />

    <style type="text/css">
        /* ── Resets ─────────────────────────────────────────────── */
        body,
        table,
        td,
        a {
            -webkit-text-size-adjust: 100%;
            -ms-text-size-adjust: 100%;
        }

        table,
        td {
            mso-table-lspace: 0pt;
            mso-table-rspace: 0pt;
        }

        img {
            -ms-interpolation-mode: bicubic;
            border: 0;
            outline: none;
            text-decoration: none;
        }

        body {
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            background-color: #F6F3EF;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
                Helvetica, Arial, sans-serif;
            color: #3F3A36;
            line-height: 1.65;
        }

        /* ── The wordmark ───────────────────────────────────────────
           Druk Condensed Heavy and DIN Condensed are the brand faces, and
           neither can be loaded here: Gmail, Outlook on Windows and Yahoo all
           ignore @font-face, which is most recipients. Licensing rules them
           out as webfonts in any case.

           So this is a fallback ladder of condensed faces that are already on
           the machine. Arial Narrow ships with Windows and macOS; Impact is
           effectively everywhere. Even with no webfont at all the name reads
           condensed and heavy rather than as generic system sans.

           Bebas Neue is linked below for the clients that do honour webfonts
           — Apple Mail, iOS Mail, Outlook for Mac — because it is the one of
           the three that is free to embed. The exact Druk cut belongs in the
           logo PNG, which is the only way to put it in front of Gmail. */
        .wordmark {
            font-family: 'Bebas Neue', 'Oswald', 'Arial Narrow',
                'Helvetica Neue Condensed', 'Franklin Gothic Medium', Impact,
                Haettenschweiler, sans-serif;
            font-weight: 700;
            font-size: 30px;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #FFFFFF;
            text-decoration: none;
            line-height: 1.1;
        }

        /* ── Type ───────────────────────────────────────────────── */
        h1 {
            margin: 0 0 10px;
            font-size: 24px;
            line-height: 1.3;
            font-weight: 700;
            color: #2C1810;
        }

        h2,
        h3 {
            margin: 0 0 12px;
            font-size: 17px;
            line-height: 1.4;
            font-weight: 700;
            color: #2C1810;
        }

        p {
            margin: 0 0 16px;
            font-size: 16px;
            line-height: 1.65;
            color: #3F3A36;
        }

        ul {
            margin: 0 0 16px;
            padding-left: 20px;
            font-size: 16px;
            color: #3F3A36;
        }

        a {
            color: #8A5A3B;
        }

        /* ── Pieces the views reach for ─────────────────────────── */
        .divider {
            height: 1px;
            line-height: 1px;
            font-size: 0;
            background: #EDE7E0;
            margin: 28px 0;
        }

        /* A warm aside, used for the things worth slowing down over. */
        .security-note {
            background: #FBF7F0;
            border-left: 3px solid #C9A227;
            padding: 16px 18px;
            margin: 22px 0;
            border-radius: 0 8px 8px 0;
        }

        .security-note p {
            margin: 0;
            font-size: 15px;
        }

        .card {
            background: #FAF8F5;
            border: 1px solid #EDE7E0;
            border-radius: 12px;
            padding: 20px;
            margin: 22px 0;
        }

        /* Verification codes. Large, spaced, and the one brown that reads
           as "this is the thing you came for". */
        .code {
            font-size: 32px;
            font-weight: 700;
            text-align: center;
            letter-spacing: 8px;
            color: #2C1810;
            background: #FAF8F5;
            border: 1px solid #EDE7E0;
            border-radius: 12px;
            padding: 18px 10px;
            margin: 22px 0;
        }

        .muted,
        .text-muted {
            color: #8A7C6E;
            font-size: 14px;
        }

        .text-center {
            text-align: center;
        }

        .mb-20 {
            margin-bottom: 20px;
        }

        .mt-20 {
            margin-top: 20px;
        }

        /* Defined because views already use them; they were previously bare. */
        .success-icon {
            font-size: 40px;
            line-height: 1;
            color: #0F973D;
            text-align: center;
        }

        .info-icon {
            font-size: 40px;
            line-height: 1;
            color: #8A5A3B;
            text-align: center;
        }

        /* Views that carry their own shell still land somewhere sensible. */
        .container {
            max-width: 600px;
            margin: 0 auto;
        }

        .header {
            text-align: center;
        }

        .footer {
            font-size: 13px;
            color: #8A7C6E;
        }

        /* A hook with no declarations of its own. Several views set their box
           padding inline, and an inline declaration outranks any normal rule in
           a stylesheet — so the only way a media query can reach them is an
           !important override on a class, which is what the phone block below
           uses. Adding this class changes nothing on a desktop. */
        .boxpad {
            /* intentionally empty */
        }

        /* ── Phones ─────────────────────────────────────────────────
           Worth doing the arithmetic rather than guessing. On a 375px screen
           the old rules left 305px of text: 12px of outer gutter each side,
           the card border, then 22px of inner padding. On a 320px phone that
           fell to 250px, which is where a line of body copy starts breaking
           awkwardly and an order reference wraps.

           So the outer gutter shrinks before the inner padding does — space
           outside the card is doing less work than space around the words.
           The vertical padding comes down too; 34px above the greeting is a
           third of the first screen spent on nothing.

           Not every client honours a media query — Outlook.com strips them,
           and Gmail only applies them for some account types. The layout is
           built to survive that: the card is width:100% with a max-width, so
           it shrinks on its own and these rules only make a narrow screen
           more comfortable rather than being what rescues it. */
        @media only screen and (max-width: 620px) {
            .wrap {
                width: 100% !important;
            }

            /* Reclaim the outer gutter first. */
            .outer {
                padding: 14px 8px !important;
            }

            .pad {
                padding-left: 20px !important;
                padding-right: 20px !important;
                padding-top: 24px !important;
                padding-bottom: 26px !important;
            }

            .brandbar {
                padding: 20px 16px !important;
            }

            h1 {
                font-size: 21px !important;
            }

            p,
            ul {
                font-size: 15px !important;
            }

            .card,
            .security-note,
            .boxpad {
                padding: 15px 16px !important;
            }

            .code {
                font-size: 24px !important;
                letter-spacing: 4px !important;
                padding: 15px 8px !important;
            }

            /* A tracking number or an order reference must not force the
               whole table wider than the screen. */
            td,
            p {
                word-break: break-word !important;
            }
        }

        /* Very small phones still in use. */
        @media only screen and (max-width: 360px) {
            .pad {
                padding-left: 16px !important;
                padding-right: 16px !important;
            }

            .code {
                font-size: 21px !important;
                letter-spacing: 2px !important;
            }
        }
    </style>
</head>

<body style="margin:0; padding:0; background-color:#F6F3EF;">
    {{!-- The inbox preview line. Without it clients grab whatever text comes
          first, which is usually "Hello <name>," on every single email. --}}
    {{#if preheader}}
    <div
        style="display:none; max-height:0; overflow:hidden; mso-hide:all; font-size:1px; line-height:1px; color:#F6F3EF; opacity:0;">
        {{preheader}}
    </div>
    {{/if}}

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
        style="background-color:#F6F3EF;">
        <tr>
            <td align="center" class="outer" style="padding: 28px 12px;">

                <table role="presentation" class="wrap" width="600" cellpadding="0" cellspacing="0" border="0"
                    style="width:600px; max-width:600px; background-color:#FFFFFF; border:1px solid #E8E1D9; border-radius:16px; overflow:hidden;">

                    <!-- Brand bar. Solid, because Outlook drops gradients and
                         the old one left white text on a white background. -->
                    <tr>
                        <td align="center" class="brandbar" bgcolor="#2C1810" style="background-color:#2C1810; padding: 26px 24px;">
                            {{#if companyLogoUrl}}
                            <img src="{{companyLogoUrl}}" alt="{{companyName}}" width="132"
                                style="display:block; width:132px; max-width:132px; height:auto; border:0;" />
                            {{else}}
                            <a href="{{websiteUrl}}" class="wordmark"
                                style="font-family:'Bebas Neue','Oswald','Arial Narrow','Helvetica Neue Condensed','Franklin Gothic Medium',Impact,Haettenschweiler,sans-serif; font-size:30px; font-weight:700; letter-spacing:3px; line-height:1.1; color:#FFFFFF; text-decoration:none; text-transform:uppercase;">{{companyName}}</a>
                            {{/if}}
                        </td>
                    </tr>

                    <tr>
                        <td class="pad" style="padding: 34px 36px 36px;">
                            {{{body}}}
                        </td>
                    </tr>

                    {{> footer }}

                </table>

            </td>
        </tr>
    </table>
</body>

</html>
