{{> header title="Verify your email" subtitle="One step left to finish setting up" }}

<p>Hello <strong>{{name}}</strong>,</p>

<p>Welcome to {{companyName}}. Confirm this is your address and your account is
    ready to use.</p>

{{> button url=verificationLink text="Verify my email" }}

<p>Or enter this code instead:</p>

<div class="code"
    style="font-size:32px; font-weight:700; text-align:center; letter-spacing:8px; color:#2C1810; background:#FAF8F5; border:1px solid #EDE7E0; border-radius:12px; padding:18px 10px; margin:22px 0;">
    {{verificationCode}}</div>

<p class="muted" style="color:#8A7C6E; font-size:14px;">The link and the code both
    expire in 24 hours.</p>

<div class="divider" style="height:1px; line-height:1px; font-size:0; background:#EDE7E0; margin:28px 0;">&nbsp;</div>

{{!-- Kept because some clients strip the href from a styled anchor, and a
      verification email that cannot be acted on is a dead end. --}}
<p class="muted" style="color:#8A7C6E; font-size:14px;">If the button does not work,
    paste this into your browser:<br />
    <a href="{{verificationLink}}" style="color:#8A5A3B; word-break:break-all;">{{verificationLink}}</a>
</p>

<p style="margin-top: 28px;">Welcome aboard,<br>The {{companyName}} Team</p>
