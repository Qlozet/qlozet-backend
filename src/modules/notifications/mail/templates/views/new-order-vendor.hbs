{{> header title="You have a new order" subtitle=confirmSubtitle }}

<p>Hello <strong>{{vendorName}}</strong>,</p>

<p>A customer has placed an order with <strong>{{businessName}}</strong>.</p>

<div class="boxpad" style="background: #FAF8F5; padding: 20px; border-radius: 8px; margin: 24px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size: 15px;">
        <tr>
            <td style="padding: 6px 0; color: #8A7C6E;">Order reference</td>
            <td style="padding: 6px 0; text-align: right; font-weight: 700;">{{orderReference}}</td>
        </tr>
        <tr>
            <td style="padding: 6px 0; color: #8A7C6E;">Placed</td>
            <td style="padding: 6px 0; text-align: right;">{{orderDate}}</td>
        </tr>
        <tr>
            <td style="padding: 6px 0; color: #8A7C6E;">
                {{itemCount}} item{{#unless singleItem}}s{{/unless}}
            </td>
            <td style="padding: 6px 0; text-align: right;"></td>
        </tr>
        <tr>
            <td style="padding: 12px 0 0; border-top: 1px solid #EDE7E0; font-weight: 700;">Order value</td>
            <td style="padding: 12px 0 0; border-top: 1px solid #EDE7E0; text-align: right; font-weight: 700;">
                {{orderTotal}}</td>
        </tr>
    </table>
</div>

{{> button url=orderUrl text="Review the order" }}

<div class="security-note" style="margin-top: 24px; background: #fff8e1; border-left-color: #f59e0b;">
    {{#if confirmWindow}}
    <p style="margin: 0;"><strong>Confirm or decline within {{confirmWindow}} of payment.</strong>
        If you don't, the order is cancelled and the customer refunded. Your
        orders page shows the exact time.</p>
    {{else}}
    <p style="margin: 0;"><strong>Confirm or decline it as soon as you can.</strong>
        The customer is waiting on it.</p>
    {{/if}}
</div>

<p style="margin-top: 28px;">The order value above is before commission and fees.
    Your earnings for it are shown on the order in your dashboard.</p>

<p>Thank you,<br>The {{companyName}} Team</p>
