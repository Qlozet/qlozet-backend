{{> header title="Welcome to the admin console" subtitle="Your account is ready" }}

<p>Hello <strong>{{name}}</strong>,</p>

{{#if invitedBy}}
<p><strong>{{invitedBy}}</strong> added you to the Qlozet admin console.</p>
{{else}}
<p>You have been added to the Qlozet admin console.</p>
{{/if}}

<p>Your role is <strong>{{roleLabel}}</strong>.</p>

<div class="card">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:15px;">
        <tr>
            <td style="padding:6px 0; color:#8A7C6E;">Email</td>
            <td style="padding:6px 0; text-align:right; font-weight:700;">{{email}}</td>
        </tr>
        <tr>
            <td style="padding:6px 0; color:#8A7C6E;">Temporary password</td>
            <td style="padding:6px 0; text-align:right; font-weight:700; letter-spacing:1px;">{{temporaryPassword}}</td>
        </tr>
    </table>
</div>

{{> button url=loginUrl text="Sign in" }}

<div class="security-note">
    <p>Change this password from your profile as soon as you sign in. It was sent
        by email, which means it is no longer a secret.</p>
</div>
