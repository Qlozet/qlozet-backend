{{> header title="Your password was updated" subtitle="A record of the change, for your files" }}

<p>Hello <strong>{{name}}</strong>,</p>

<p>Your password was updated on <strong>{{updateDate}}</strong>.</p>

<div class="security-note"
    style="background:#FBF7F0; border-left:3px solid #C9A227; padding:16px 18px; margin:22px 0; border-radius:0 8px 8px 0;">
    <p style="margin:0; font-size:15px;">If you did not make this change, write to
        <a href="mailto:{{supportEmail}}" style="color:#8A5A3B;">{{supportEmail}}</a>
        now. We would rather hear from you and find nothing wrong.</p>
</div>

<div class="divider" style="height:1px; line-height:1px; font-size:0; background:#EDE7E0; margin:28px 0;">&nbsp;</div>

<h3 style="color:#2C1810; margin:0 0 12px;">Keeping the account safe</h3>
<ul style="margin:0; padding-left:20px; color:#3F3A36;">
    <li style="margin-bottom:8px;">Keep this password to {{companyName}} alone.</li>
    <li style="margin-bottom:8px;">Pick something long rather than something complicated.</li>
    <li>Pay and message only through {{companyName}}.</li>
</ul>

<p style="margin-top: 28px;">Thank you,<br>The {{companyName}} Team</p>
